"""
Q-Orbit: Quantum Space Mission Designer
NASA Space Apps Challenge 2026 - Primary Submission: Space Mission Design Game
Implements NASA JPL Vis-Viva Equation, Hohmann Transfer Delta-V, Tsiolkovsky Rocket Equation,
and Quantum-Inspired QUBO Mission Trajectory Optimization.
"""

import math

# Official NASA JPL Horizons Constants
MU_SUN_KM3_S2 = 1.32712440018e11  # Solar gravitational parameter (km^3/s^2)
G0_M_S2 = 9.80665                 # Standard Earth gravity (m/s^2)
AU_KM = 149597870.7               # 1 Astronomical Unit (km)

ORBITAL_RADII_KM = {
    "Earth": 1.000 * AU_KM,
    "Mars": 1.524 * AU_KM,
    "Venus": 0.723 * AU_KM,
}

# Candidate Rocket Propulsion Stages (NASA LSP Benchmarks)
PROPULSION_OPTIONS = [
    {"name": "LOX/LH2 Cryogenic Upper Stage", "isp": 452.0, "dry_mass_kg": 4500.0, "cost_m": 120.0},
    {"name": "LOX/CH4 Methalox Stage", "isp": 380.0, "dry_mass_kg": 5200.0, "cost_m": 85.0},
    {"name": "Nuclear Thermal Propulsion (NTP)", "isp": 900.0, "dry_mass_kg": 8500.0, "cost_m": 310.0},
]


def vis_viva_velocity_km_s(mu: float, r_km: float, a_km: float) -> float:
    """Computes orbital velocity (km/s) using the NASA Vis-Viva equation: v^2 = mu * (2/r - 1/a)."""
    return math.sqrt(mu * ((2.0 / r_km) - (1.0 / a_km)))


def hohmann_transfer_delta_v_m_s(origin: str, destination: str) -> tuple[float, float, float]:
    """Calculates Hohmann transfer departure dv1, arrival dv2, and total delta-v (m/s)."""
    r1 = ORBITAL_RADII_KM[origin]
    r2 = ORBITAL_RADII_KM[destination]
    a_transfer = 0.5 * (r1 + r2)

    v_origin = math.sqrt(MU_SUN_KM3_S2 / r1)
    v_dest = math.sqrt(MU_SUN_KM3_S2 / r2)

    v_dep = vis_viva_velocity_km_s(MU_SUN_KM3_S2, r1, a_transfer)
    v_arr = vis_viva_velocity_km_s(MU_SUN_KM3_S2, r2, a_transfer)

    dv1_m_s = abs(v_dep - v_origin) * 1000.0
    dv2_m_s = abs(v_dest - v_arr) * 1000.0
    return dv1_m_s, dv2_m_s, (dv1_m_s + dv2_m_s)


def required_propellant_mass_kg(delta_v_m_s: float, isp_s: float, dry_plus_payload_kg: float) -> float:
    """Inverts the Tsiolkovsky rocket equation to find required propellant mass (kg)."""
    mass_ratio = math.exp(delta_v_m_s / (isp_s * G0_M_S2))
    initial_mass_kg = dry_plus_payload_kg * mass_ratio
    return initial_mass_kg - dry_plus_payload_kg


def quantum_qubo_stage_selector(total_dv_m_s: float, payload_kg: float, max_budget_m: float = 250.0):
    """
    Quantum-inspired QUBO solver minimizing Hamiltonian H = Mass_Cost + Penalty * Budget_Violation
    to select the optimal propulsion architecture for the mission.
    """
    best_stage = None
    best_hamiltonian = float("inf")

    for stage in PROPULSION_OPTIONS:
        total_dry = stage["dry_mass_kg"] + payload_kg
        prop_mass = required_propellant_mass_kg(total_dv_m_s, stage["isp"], total_dry)

        # QUBO penalty term if mission cost exceeds budget constraint
        budget_violation = max(0.0, stage["cost_m"] - max_budget_m)
        penalty = 50000.0 * (budget_violation ** 2)
        hamiltonian = prop_mass + penalty

        if hamiltonian < best_hamiltonian:
            best_hamiltonian = hamiltonian
            best_stage = (stage["name"], prop_mass, stage["cost_m"])

    return best_stage


def main():
    print("=== Q-ORBIT: QUANTUM SPACE MISSION DESIGNER (NASA JPL ASTRODYNAMICS) ===\n")
    payload_kg = 12000.0
    dv1, dv2, total_dv = hohmann_transfer_delta_v_m_s("Earth", "Mars")

    print(f"Mission Profile: Earth -> Mars Hohmann Transfer (Payload: {payload_kg:,.0f} kg)")
    print(f"  Departure Burn (dv1): {dv1:,.2f} m/s")
    print(f"  Arrival Burn   (dv2): {dv2:,.2f} m/s")
    print(f"  Total Heliocentric Delta-V: {total_dv:,.2f} m/s\n")

    winner_name, prop_kg, cost_m = quantum_qubo_stage_selector(total_dv, payload_kg)
    print("=== QUANTUM QUBO OPTIMAL MISSION CONFIGURATION ===")
    print(f"  Selected Propulsion: {winner_name}")
    print(f"  Required Propellant: {prop_kg:,.2f} kg | Estimated Stage Cost: ${cost_m:.1f}M")


if __name__ == "__main__":
    main()
